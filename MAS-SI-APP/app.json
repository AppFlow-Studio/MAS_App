{
  "expo": {
    "name": "MAS Staten Island",
    "owner": "appflow-studios",
    "slug": "MAS-SI-APP",
    "version": "1.0.14",
    "orientation": "portrait",
    "icon": "./assets/images/massicliquidglassicon.png",
    "scheme": "MAS-SI-APP",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "icon": "./assets/images/Mas-SI-Glass.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.MAS-SI-APP",
      "usesAppleSignIn": true,
      "newArchEnabled": true,
      "userInterfaceStyle": "light",
      "associatedDomains": ["applinks:yourdomain.com"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIUserInterfaceStyle": "Light",
        "NSCameraUsageDescription": "$(PRODUCT_NAME) uses your camera to let you take a new photo for your profile picture or capture images to upload to community events, programs, and business ads."
      }
    },
    "android": {
      "package": "com.anonymous.MASSIAPP"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.991344123272-nk55l8nc7dcloc56m6mmnvnkhdtjfcbf"
        }
      ],
      "expo-web-browser",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/massicliquidglassicon.png",
          "color": "#1d4681"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.MAS-SI-APP",
          "urlScheme": "MAS-SI-APP"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "23272993-d42e-4c74-b945-556f2c9c4700"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/23272993-d42e-4c74-b945-556f2c9c4700"
    }
  }
}
